/*
 *  PersianKit.rc  -  version resource of PersianKit.dll
 *  ---------------------------------------------------------------------
 *  A Notepad++ plugin listed in nppPluginList must carry a real
 *  VERSIONINFO resource: Plugins Admin (and the list validator) read the
 *  numeric FILEVERSION and compare it with the entry's "version".  A DLL
 *  without this resource is rejected with "Does not contain any version
 *  information."
 *
 *  The numbers come from src/version.h - never hardcode them here.
 */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PK_VERSION_MAJOR,PK_VERSION_MINOR,PK_VERSION_PATCH,PK_VERSION_BUILD
 PRODUCTVERSION PK_VERSION_MAJOR,PK_VERSION_MINOR,PK_VERSION_PATCH,PK_VERSION_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mohammad Ahmadkhanloo"
            VALUE "FileDescription",  "PersianKit - RTL and Vazirmatn for Notepad++"
            VALUE "FileVersion",      PK_VERSION_STR
            VALUE "InternalName",     "PersianKit"
            VALUE "LegalCopyright",   "GNU GPL v3.0"
            VALUE "OriginalFilename", "PersianKit.dll"
            VALUE "ProductName",      "PersianKit"
            VALUE "ProductVersion",   PK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
